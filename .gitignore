# ==============================================================================
# Git Ignore Configuration - Gemini Chatbot Project
# ==============================================================================

# 1. Environment Files & Secrets (NEVER commit live API keys or credentials)
.env
.env.*
*.env
!*.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
.pnp
.pnp.js

# 3. Logs & Process Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Production & Build Outputs
dist/
build/
out/
.cache/

# 5. Operating System Junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDE & Editor Artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 7. Temporary / Scratch Files
tmp/
temp/
*.tmp
