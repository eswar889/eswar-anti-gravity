# ==============================================================================
# Gemini Chatbot Frontend Environment Variables Template
# ==============================================================================

# Backend API Base URL
BACKEND_URL=http://localhost:5000

# Supabase Public Database Configuration
# Obtain your project URL and Anon key from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
